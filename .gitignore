# ============================================================
# Nexus Agent Platform — .gitignore
# ============================================================

# ---- Temp / log files ----
*.log
out.txt
.coverage
htmlcov/
proxy_*.txt
*.pid

# ---- Build outputs ----
dist/
dist-embed/
build/
.vite/
*.tsbuildinfo

# ---- Node (frontend) ----
node_modules/
frontend/node_modules/

# ---- Python ----
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
*.egg-info/
.eggs/

# ---- Test / CI runtime artifacts ----
tmp/
playwright-report/
test-results/
nexus-agent/artifacts/
nexus-agent/tests/stability_history.json

# ---- IDE / OS ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Environment (secrets stay local; .env.example IS tracked) ----
.env
.env.local
.env.*.local
.env.*.local.*

# ---- Secrets ----
token.txt
*.token
*.jwt
tokens/
